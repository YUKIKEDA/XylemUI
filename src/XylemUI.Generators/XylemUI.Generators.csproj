<Project Sdk="Microsoft.NET.Sdk">
  <!-- The source generators of XylemUI (design §0.1, §7 "Shortcuts and actions"). They run in the compiler on the build machine
       and never ship in an app; XylemUI.Core's package carries the assembly under analyzers/dotnet/cs (.cursor/rules/aot.mdc). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>XylemUI.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- A compiler component: it is not a library of an app, so it is neither packed by itself nor checked for NativeAOT. -->
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization></InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The list of the diagnostics the generators report (analyzer release tracking, RS2008). -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
