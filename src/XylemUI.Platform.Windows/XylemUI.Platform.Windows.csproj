<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>XylemUI.Platform.Windows</RootNamespace>
    <Description>The Win32 platform backend of XylemUI.</Description>
    <!-- Interop project (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XylemUI.Core\XylemUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Platform.Windows.Tests" />
    <!-- The renderer tests drive the real message loop (IterationHook) with a swap chain as the frame clock. -->
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11.Tests" />
  </ItemGroup>
</Project>
