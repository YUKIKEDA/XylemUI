<Project>
  <!--
    Imported by an app that references XylemUI.Text. Under NativeAOT, HarfBuzz is linked into the executable: the
    P/Invokes resolve directly to the static library (DirectPInvoke + NativeLibrary, design §9), and the DLL the JIT uses is
    left out of the published files, so the app ships as one executable. vendor/build.ps1 makes the library. Glyphs are
    rasterized by the OS (DirectWrite on Windows), so FreeType is not linked (design §5.0.3; Linux links it, roadmap row P04).
  -->
  <PropertyGroup>
    <XylemUITextNativeDirectory>$(MSBuildThisFileDirectory)..\..\vendor\out\win-x64\</XylemUITextNativeDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="harfbuzz" />
    <NativeLibrary Include="$(XylemUITextNativeDirectory)static\harfbuzz.lib" />
  </ItemGroup>
  <Target Name="XylemUILeaveOutTextDlls" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'harfbuzz.dll'" />
    </ItemGroup>
  </Target>
</Project>
