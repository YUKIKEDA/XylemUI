<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XylemUI.Text</RootNamespace>
    <Description>The XylemUI text pipeline: shaping with HarfBuzz, the font fallback, and the glyph atlas, whose glyphs an IGlyphRasterizer draws.</Description>
    <!-- The native wrappers of the text pipeline (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Text.Tests" />
    <!-- The text leaf of row V1a lays text out with the internal ShapingResult (design §4.1, the wrapping API, T1b). -->
    <InternalsVisibleTo Include="XylemUI.Core" />
    <!-- The PNG decoder and the scaler of bitmap color glyphs, for the Windows rasterizer and its tests (roadmap row T9). -->
    <InternalsVisibleTo Include="XylemUI.Platform.Windows" />
    <InternalsVisibleTo Include="XylemUI.Platform.Windows.Tests" />
    <!-- The threshold of the atlas's worker threads, which the glyph-resolve scenario moves to measure it (roadmap row T5). -->
    <InternalsVisibleTo Include="XylemUI.E2E" />
    <!-- The decoration metrics of a font, which the pixel tests of the ranges place their reference lines by (roadmap row T12). -->
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11.Tests" />
    <!-- The goldens of the headless tests are read with the PNG decoder (design §12.3, row P02a2). -->
    <InternalsVisibleTo Include="XylemUI.Testing" />
  </ItemGroup>
  <!-- The end of the font fallback (design §4.5, Fonts/README.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\XylemUIFallback.ttf" LogicalName="XylemUIFallback.ttf" />
  </ItemGroup>
  <!-- Under the JIT HarfBuzz loads as a DLL next to the app; a NativeAOT app links it statically (XylemUI.Text.targets). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\vendor\out\win-x64\shared\harfbuzz.dll')">
    <None
      Include="$(MSBuildThisFileDirectory)..\..\vendor\out\win-x64\shared\harfbuzz.dll"
      Link="%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
