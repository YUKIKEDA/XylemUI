<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XylemUI.Text</RootNamespace>
    <Description>The XylemUI text pipeline: shaping with HarfBuzz, rasterizing with FreeType, and the glyph atlas.</Description>
    <!-- The native wrappers of the text pipeline (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Text.Tests" />
  </ItemGroup>
  <!-- The end of the font fallback (design §4.5, Fonts/README.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\XylemUIFallback.ttf" LogicalName="XylemUIFallback.ttf" />
  </ItemGroup>
  <!-- Under the JIT the libraries load as DLLs next to the app; a NativeAOT app links them statically (XylemUI.Text.targets). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\vendor\out\win-x64\shared\harfbuzz.dll')">
    <None
      Include="$(MSBuildThisFileDirectory)..\..\vendor\out\win-x64\shared\*.dll"
      Link="%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
