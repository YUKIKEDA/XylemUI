<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XylemUI</RootNamespace>
    <Description>The XylemUI engine: reactive runtime, invalidation, layout, and display lists.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Text runs are shaped and their glyphs put in the atlas while the display list is built (design §4.3, §5.0.3). -->
    <ProjectReference Include="..\XylemUI.Text\XylemUI.Text.csproj" />
    <ProjectReference Include="..\XylemUI.Imaging\XylemUI.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The source generators ship inside this package, under analyzers/dotnet/cs, so that an app that references XylemUI.Core gets
         them with it (.cursor/rules/aot.mdc). Inside the repository a project that declares actions references the generator
         project as an analyzer. -->
    <ProjectReference Include="..\XylemUI.Generators\XylemUI.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None
      Include="..\XylemUI.Generators\bin\$(Configuration)\netstandard2.0\XylemUI.Generators.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
  <!-- The path above is where the generator project builds to. A setting that moves its output would drop the generator from
       the package without a word, so a pack with no file there fails (PR #810's review). -->
  <Target Name="XylemCheckGeneratorsInPackage" BeforeTargets="GenerateNuspec">
    <Error
      Condition="!Exists('..\XylemUI.Generators\bin\$(Configuration)\netstandard2.0\XylemUI.Generators.dll')"
      Text="XylemUI.Generators.dll was not found where XylemUI.Core packs it from (analyzers/dotnet/cs)."
    />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Core.Tests" />
    <!-- The benchmarks time the internal layout and reactive paths (roadmap row M1a). -->
    <InternalsVisibleTo Include="XylemUI.E2E" />
    <!-- Tests that need a real Win32 window or message loop (the render guard, the dispatcher in the loop) live there. -->
    <InternalsVisibleTo Include="XylemUI.Platform.Windows.Tests" />
    <!-- The hit regions are tested against the pixels drawn on WARP (row R4e). -->
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11.Tests" />
    <!-- The D3D11 renderer is what a window's frames draw on (IRenderTarget, row V1b). -->
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11" />
    <!-- The window hands its pointer input to the tree's input and implements what the input asks of it (IPointerPlatform, row V1c). -->
    <InternalsVisibleTo Include="XylemUI.Platform.Windows" />
    <!-- The app's host joins the window, the renderer, the frames, and the input of a tree (row V1d); the boundary is row C0's. -->
    <InternalsVisibleTo Include="XylemUI.Desktop" />
    <InternalsVisibleTo Include="XylemUI.Desktop.Tests" />
    <!-- The button routes the click its Enter and Space make, and sets its pressed state (row K1b); the boundary is row C0's. -->
    <InternalsVisibleTo Include="XylemUI.Primitives" />
    <!-- The primitives are tested on a tree with no window (row V1d). -->
    <InternalsVisibleTo Include="XylemUI.Primitives.Tests" />
    <!-- The icon tests read an icon's node and box (row IC1). -->
    <InternalsVisibleTo Include="XylemUI.Theme.Fluent.Tests" />
    <!-- Text leaves are measured with HarfBuzz, whose native library the Windows-only text tests load (row V1a). -->
    <InternalsVisibleTo Include="XylemUI.Text.Tests" />
    <!-- The headless harness ships with Core's version and drives the internal input, frames, and tree (design §12, P02a). -->
    <InternalsVisibleTo Include="XylemUI.Testing" />
    <!-- The WARP renderer hands a headless app its IRenderTarget (design §12.3, row P02a2). -->
    <InternalsVisibleTo Include="XylemUI.Testing.D3D11" />
    <!-- The harness's tests make a renderer of their own to test the goldens on every OS (row P02a2). -->
    <InternalsVisibleTo Include="XylemUI.Testing.Tests" />
  </ItemGroup>
</Project>
