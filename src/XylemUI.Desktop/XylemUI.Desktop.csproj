<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XylemUI</RootNamespace>
    <Description>Starts a XylemUI app: makes the OS host the app was built with and opens its window through the platform contract (design §2.13, §6.0).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- No host: the app references the one for its runtime identifier, which its module initializer registers (design §6.0,
         "ホストの選び方"). -->
    <ProjectReference Include="..\XylemUI.Core\XylemUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The real window's tests: the click on the sample's button, the frames, and the scope of the window (row V1d). -->
    <InternalsVisibleTo Include="XylemUI.Desktop.Tests" />
  </ItemGroup>
</Project>
