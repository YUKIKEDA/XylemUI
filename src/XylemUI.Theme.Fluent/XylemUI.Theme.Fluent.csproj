<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Fluent 2 design system (design §13.2). Its icons (design §5.0.4): FluentIcons, generated by tools/FluentIconsTool from the
    maps of vendor/out/fluent. An app that uses them imports XylemUI.Theme.Fluent.targets, which keeps the glyphs it uses. Its theme
    values (design §13.2, "テーマの値"): FluentTheme, whose tokens FluentTokens.g.cs holds, generated by tools/FluentTokensTool from
    the token files of vendor/out/fluent/tokens.
  -->
  <ItemGroup>
    <ProjectReference Include="..\XylemUI.Primitives\XylemUI.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Theme.Fluent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MIT notice of Fluent UI System Icons, whose names and glyphs the package carries (the owner's decision on PR #925). -->
    <None Include="LICENSE-FluentSystemIcons.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
