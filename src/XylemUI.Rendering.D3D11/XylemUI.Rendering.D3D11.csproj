<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XylemUI.Rendering.D3D11</RootNamespace>
    <Description>The Direct3D 11 renderer of XylemUI.</Description>
    <!-- Interop project (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XylemUI.Core\XylemUI.Core.csproj" />
    <!-- The glyph atlas pages the renderer uploads (design §5.0.3). -->
    <ProjectReference Include="..\XylemUI.Text\XylemUI.Text.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11.Tests" />
  </ItemGroup>
</Project>
