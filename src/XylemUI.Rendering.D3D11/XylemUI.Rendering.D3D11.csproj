<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XylemUI.Rendering.D3D11</RootNamespace>
    <Description>The Direct3D 11 renderer of XylemUI.</Description>
    <!-- Interop project (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plain net10.0, as the Windows host that references it (design §6.0, "ホストの選び方"); the attribute is the oldest Windows
         it runs on (design §1), which the platform analyzer (CA1416) holds its callers to. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.22000</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XylemUI.Core\XylemUI.Core.csproj" />
    <!-- The glyph atlas pages the renderer uploads (design §5.0.3). -->
    <ProjectReference Include="..\XylemUI.Text\XylemUI.Text.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XylemUI.Rendering.D3D11.Tests" />
    <!-- The frame measurements (GPU time, present latency) are for the benchmarks only (roadmap row M1a). -->
    <InternalsVisibleTo Include="XylemUI.E2E" />
    <!-- The real window's tests count the draws and read the pixels of the sample (row V1d). -->
    <InternalsVisibleTo Include="XylemUI.Desktop.Tests" />
    <!-- The headless WARP renderer draws offscreen and reads the frame back (CreateOffscreen, CaptureFrame; design §12.3). -->
    <InternalsVisibleTo Include="XylemUI.Testing.D3D11" />
  </ItemGroup>
</Project>
