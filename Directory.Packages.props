<Project>
  <!-- Central Package Management. A new dependency is checked against .cursor/rules/dependencies.mdc first. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Interop">
    <!-- Declarations only (design §0 Dependency Decision Matrix). -->
    <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>
  <ItemGroup Label="Build tools">
    <!-- The compiler API the source generators are written against (src/XylemUI.Generators); it runs in the compiler on the build
         machine and never ships in an app (design §7, "Shortcuts and actions"). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- The editor's API the code fixes of the analyzers are written against (src/XylemUI.Analyzers.CodeFixes), at the version of
         the compiler's API above; the command-line compiler does not carry it, so the code fixes are an assembly of their own
         (design §2.2, "Analyzers", row A1). It never ships in an app. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <!-- Writes the kept icon fonts into an app's assembly on the build machine; never in an app (design §5.0.4, §0). -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- What XylemUI.Testing.XUnit builds [UiFact] on, at the version xunit.v3 brings (row P02a). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- The version of Microsoft.Testing.Platform that xunit.v3 brings (row Q5). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>
</Project>
