<Project>
  <!-- Central Package Management. A new dependency is checked against .cursor/rules/dependencies.mdc first. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.82-beta" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Interop">
    <!-- Declarations only (design §0 Dependency Decision Matrix). -->
    <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>
  <ItemGroup Label="Build tools">
    <!-- Writes the kept icon fonts into an app's assembly on the build machine; never in an app (design §5.0.4, §0). -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- What XylemUI.Testing.XUnit builds [UiFact] on, at the version xunit.v3 brings (row P02a). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- The version of Microsoft.Testing.Platform that xunit.v3 brings (row Q5). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>
</Project>
