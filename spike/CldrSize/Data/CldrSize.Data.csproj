<Project Sdk="Microsoft.NET.Sdk">
  <!-- The generated tables of the configuration (SpikeDataCompile); the executable's Select.g.cs names the locales it reads. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>CldrSize</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SpikeConfig Condition="'$(SpikeConfig)' == ''">baseline</SpikeConfig>
  </PropertyGroup>
  <Import Project="../Generated/$(SpikeConfig)/Config.props" Condition="Exists('../Generated/$(SpikeConfig)/Config.props')" />
  <ItemGroup>
    <Compile Include="@(SpikeDataCompile)" />
  </ItemGroup>
</Project>
