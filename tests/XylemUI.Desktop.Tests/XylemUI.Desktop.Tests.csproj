<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>XylemUI.Desktop.Tests</RootNamespace>
    <!-- A test finds the app's window by its title through TerraFX's pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XylemUI.Desktop\XylemUI.Desktop.csproj" />
    <!-- The tests run the sample's own root function (row V1d). -->
    <ProjectReference Include="..\..\samples\Counter\Counter.csproj" />
    <ProjectReference Include="..\..\samples\Todo\Todo.csproj" />
    <!-- The app tests run headless, as [UiFact] tests (design §12, row P02a). -->
    <ProjectReference Include="..\..\src\XylemUI.Testing.XUnit\XylemUI.Testing.XUnit.csproj" />
    <!-- The pixels and the goldens are drawn headless on WARP (design §12.3, row P02a2). -->
    <ProjectReference Include="..\..\src\XylemUI.Testing.D3D11\XylemUI.Testing.D3D11.csproj" />
  </ItemGroup>
  <!-- The image element's tests read the decoders' test images, from files, and one as a resource (row IM1, 1b-2). -->
  <ItemGroup>
    <None Include="..\XylemUI.Imaging.Tests\Images\baseline.jpg" Link="Images\baseline.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\XylemUI.Imaging.Tests\Images\lossless.webp" Link="Images\lossless.webp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\XylemUI.Imaging.Tests\Images\first-frame.gif" Link="Images\first-frame.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\XylemUI.Imaging.Tests\Images\rgb24.bmp" Link="Images\rgb24.bmp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\XylemUI.Imaging.Tests\Images\png.ico" Link="Images\png.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\XylemUI.Imaging.Tests\Png\PngSuite\basn2c08.png" Link="Images\basn2c08.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\XylemUI.Imaging.Tests\Images\baseline.jpg" LogicalName="image.jpg" />
  </ItemGroup>
  <!-- The UIA tests read the window's tree with Windows' UIA client, UIAutomationClient (row P02g), as spike S10 did. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
    <PackageReference Include="xunit.v3" />
    <!-- build.ps1 dumps the process and names the tests running when the run hangs (row Q5). -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>
</Project>
