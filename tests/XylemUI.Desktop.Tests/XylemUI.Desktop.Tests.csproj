<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>XylemUI.Desktop.Tests</RootNamespace>
    <!-- A test finds the app's window by its title through TerraFX's pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XylemUI.Desktop\XylemUI.Desktop.csproj" />
    <!-- The tests run the sample's own root function (row V1d). -->
    <ProjectReference Include="..\..\samples\Counter\Counter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
