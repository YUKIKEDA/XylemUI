<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The native libraries are built for Windows only until roadmap rows P04 and P06, so these tests run on Windows only. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>XylemUI.Text.Tests</RootNamespace>
    <!-- The allocation tests measure under JIT; tiered compilation adds one-off allocations (.cursor/rules/bench.mdc). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XylemUI.Text\XylemUI.Text.csproj" />
    <!-- DisplayList.DrawText (Core) puts shaped text in the atlas; its tests need the native libraries, so they are here. -->
    <ProjectReference Include="..\..\src\XylemUI.Core\XylemUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- The test font moved to XylemUI.Testing, which embeds it (design §12.3); the tests that open it from a file read it here. -->
    <None Include="..\..\src\XylemUI.Testing\Fonts\XylemUITestSans.ttf" Link="Fonts\XylemUITestSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Png\PngSuite\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Unicode conformance tests, copied from UCD.zip by tools/UnicodeTableGen (design §8.13). -->
    <None Include="Unicode\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
