<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XylemUI.Tests</RootNamespace>
    <!--
      The allocation tests measure GC.GetAllocatedBytesForCurrentThread under JIT. With tiered compilation on, the macOS runner
      reported a one-off 248 to 7,112 bytes in the measured window in 2 of 3 runs (S6a, PR #26); with it off, 0 bytes in every
      window. Which part of the tier-up allocates was not identified. NativeAOT, which has no tiering, measured 0 bytes.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XylemUI.Core\XylemUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\Taffy\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
