<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XylemUI.Tests</RootNamespace>
    <!--
      The allocation tests measure GC.GetAllocatedBytesForCurrentThread under JIT. With tiered compilation on, the macOS runner
      reported a one-off 248 to 7,112 bytes in the measured window in 2 of 3 runs (S6a, PR #26). The one-off bytes that stayed
      came from background GCs, which tests/Directory.Build.props turns off (Issue #332, row Q1).
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XylemUI.Core\XylemUI.Core.csproj" />
    <!-- Built, not referenced: the tests run the CLDR table generator on a zip they make (design §4.11, "Tests"). -->
    <ProjectReference
      Include="..\..\tools\CldrTableGen\CldrTableGen.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\Taffy\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\XylemUI\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
