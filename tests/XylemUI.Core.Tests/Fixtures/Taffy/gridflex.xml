<tests source="https://github.com/DioxusLabs/taffy/tree/0064bd54/tests/xml/gridflex">
  <test name="gridflex_column_integration__border_box_ltr" use-rounding="true">
    <viewport width="max-content" height="max-content" />
    <input>
      <div direction="ltr" position="absolute" flex-direction="column">
        <div display="grid" direction="ltr" position="relative" grid-template-rows="1fr 1fr" grid-template-columns="1fr 1fr">
          <text direction="ltr" position="relative">
          HH
        </text>
          <text direction="ltr" position="relative">
          HH
        </text>
          <text direction="ltr" position="relative">
          HH
        </text>
          <text direction="ltr" position="relative">
          HH
        </text>
        </div>
      </div>
    </input>
    <expectations>
      <node x="0" y="0" width="40" height="20">
        <node x="0" y="0" width="40" height="20" resolved-rows="10px 10px" resolved-columns="20px 20px">
          <node x="0" y="0" width="20" height="10" />
          <node x="20" y="0" width="20" height="10" />
          <node x="0" y="10" width="20" height="10" />
          <node x="20" y="10" width="20" height="10" />
        </node>
      </node>
    </expectations>
  </test>
  <test name="gridflex_container_baseline_from_baseline_item_with_margin_top__border_box_ltr" use-rounding="true">
    <viewport width="max-content" height="max-content" />
    <input>
      <div display="flex" direction="ltr" position="absolute" align-items="baseline" width="200px" height="100px">
        <div display="grid" direction="ltr" position="relative" align-items="baseline" grid-template-columns="50px 50px">
          <div display="grid" direction="ltr" position="relative" height="30px" margin-top="10px">
            <div direction="ltr" position="relative" width="20px" height="20px" />
          </div>
          <div direction="ltr" position="relative" height="40px" />
        </div>
        <div direction="ltr" position="relative" width="10px" height="10px" />
      </div>
    </input>
    <expectations>
      <node x="0" y="0" width="200" height="100">
        <node x="0" y="0" width="100" height="50" resolved-rows="50px" resolved-columns="50px 50px">
          <node x="0" y="20" width="50" height="30" resolved-rows="30px" resolved-columns="50px">
            <node x="0" y="0" width="20" height="20" />
          </node>
          <node x="50" y="0" width="50" height="40" />
        </node>
        <node x="100" y="30" width="10" height="10" />
      </node>
    </expectations>
  </test>
  <test name="gridflex_container_baseline_from_non_baseline_item_center__border_box_ltr" use-rounding="true">
    <viewport width="max-content" height="max-content" />
    <input>
      <div display="flex" direction="ltr" position="absolute" align-items="baseline" width="120px" height="100px">
        <div display="grid" direction="ltr" position="relative" align-items="center" width="100px" height="50px">
          <div display="grid" direction="ltr" position="relative" width="26px" height="30px">
            <div direction="ltr" position="relative" width="26px" height="21px" />
          </div>
        </div>
        <div direction="ltr" position="relative" width="10px" height="10px" />
      </div>
    </input>
    <expectations>
      <node x="0" y="0" width="120" height="100">
        <node x="0" y="0" width="100" height="50" resolved-rows="50px" resolved-columns="100px">
          <node x="0" y="10" width="26" height="30" resolved-rows="30px" resolved-columns="26px">
            <node x="0" y="0" width="26" height="21" />
          </node>
        </node>
        <node x="100" y="21" width="10" height="10" />
      </node>
    </expectations>
  </test>
