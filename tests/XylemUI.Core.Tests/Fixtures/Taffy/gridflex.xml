  </test>
  <test name="gridflex_kitchen_sink_minimise3__border_box_ltr" use-rounding="true">
    <viewport width="max-content" height="max-content" />
    <input>
      <div direction="ltr" position="absolute" width="50px">
        <div display="grid" direction="ltr" position="relative" grid-template-rows="30% 10%" grid-template-columns="auto 10%">
          <div direction="ltr" position="relative" width="20px" height="20px" />
          <div direction="ltr" position="relative" />
          <div direction="ltr" position="relative" />
          <div direction="ltr" position="relative" />
        </div>
      </div>
    </input>
    <expectations>
      <node x="0" y="0" width="50" height="20">
        <node x="0" y="0" width="20" height="20" resolved-rows="6px 2px" resolved-columns="20px 2px">
          <node x="0" y="0" width="20" height="20" />
          <node x="20" y="0" width="2" height="6" />
          <node x="0" y="6" width="20" height="2" />
          <node x="20" y="6" width="2" height="2" />
        </node>
      </node>
    </expectations>
  </test>
  <test name="gridflex_negative_margin_hidden_grid_item_intrinsic_height__border_box_ltr" use-rounding="true">
    <viewport width="max-content" height="max-content" />
    <input>
      <div display="flex" direction="ltr" position="absolute" flex-direction="column" width="400px">
        <div display="flex" direction="ltr" position="relative" flex-direction="column">
          <div display="flex" direction="ltr" position="relative" flex-direction="column" margin-top="-32px">
            <div display="grid" direction="ltr" position="relative" grid-template-columns="100px">
              <div
                display="flex"
                direction="ltr"
                position="relative"
                flex-direction="column"
                overflow-x="hidden"
                overflow-y="hidden"
                scrollbar-width="15"
              >
                <div direction="ltr" position="relative" width="100px" height="100px" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </input>
    <expectations>
      <node x="0" y="0" width="400" height="68">
        <node x="0" y="0" width="400" height="68">
          <node x="0" y="-32" width="400" height="100">
            <node x="0" y="0" width="400" height="100" resolved-rows="100px" resolved-columns="100px">
              <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
                <node x="0" y="0" width="100" height="100" />
              </node>
            </node>
          </node>
        </node>
      </node>
    </expectations>
  </test>
