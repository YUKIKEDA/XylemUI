<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!--
    Every test project uses XylemUI.Testing: its Zero-Alloc assertion, its clock, and its UI thread, which the shared fixture runs a
    test's code on (one UI thread for the process, design §12.5, "Threads"). The tests run with concurrent GC, as an app's tests do:
    PerformanceAssert runs again a window that a background GC overlapped (design §11.3, Issue #332).
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'XylemUI.Testing.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/XylemUI.Testing/XylemUI.Testing.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UiThreadFixture.cs" Link="UiThreadFixture.cs" />
    <Using Include="XylemUI.TestSupport" />
    <Using Include="XylemUI.Testing" />
  </ItemGroup>
  <!-- The package imports it in an app's test project; the repository's import it here (the goldens' folder, design §12.3). -->
  <Import Project="$(MSBuildThisFileDirectory)../src/XylemUI.Testing/build/XylemUI.Testing.targets" />
</Project>
